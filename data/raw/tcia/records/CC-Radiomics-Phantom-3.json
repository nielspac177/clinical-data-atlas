      "descriptions": [
        {
          "description": "This collection consists of a dearth of phantom scans on large samples. This data collection contains 100 scanners using three protocols. This provides population data that can be used to quantify inter-scanner variability. This data can be used to determine how robust specific radiomics or other quantitative imaging signatures are.",
          "descriptionType": "Abstract"
        }
