      "descriptions": [
        {
          "description": "This collection contains data from the National Cancer Institute Clinical Trial NCT00980460, \"Risk-Based Therapy in Treating Younger Patients With Newly Diagnosed Liver Cancer.\" It was sponsored by NCI's Children’s Oncology Group (COG) under study number AHEP0731. This phase III trial studies the side effects and how well risk-based therapy works in treating younger patients with newly diagnosed liver cancer. Select individual patient-level data from this trial can be requested from the NCTN/NCORP Data Archive.",
          "descriptionType": "Abstract",
          "lang": null
        }
      ],
