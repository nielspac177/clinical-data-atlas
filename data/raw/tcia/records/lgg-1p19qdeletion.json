      "descriptions": [
        {
          "description": "These MRIs are pre-operative examinations performed in subjects with Low Grade Gliomas (WHO grade II &amp; III). All of these subjects have biopsy proven 1p19q results, performed using FISH. Segmentation of tumors in three axial slices that include the one with the largest tumor diameter and ones below and above also provided in NiFTI format.",
          "descriptionType": "Abstract",
          "lang": null
        }
