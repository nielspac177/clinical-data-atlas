      "dates": [],
      "descriptions": [
        {
          "description": "We present a dataset composed of 103 cases of magnetic resonance (MR) and histopathologic imaging from patients with brain metastasis from primary lung cancer. We provide pre-operative T1-weighted contrast-enhanced (T1CE) and fluid attenuated inversion recovery (FLAIR) MR images with matched whole slide images of formalin-fixed, paraffin-embedded (FFPE) brain metastasis biopsies. This dataset also includes segmentations of contrast enhancement and FLAIR hyperintensity, radiomic features, and clinical information. ",
          "descriptionType": "Abstract",
          "lang": null
        }
