      "descriptions": [
        {
          "description": "The objective of the ACRIN 6684 multi-center clinical trial was to determine the association of baseline FMISO PET uptake (maximal tumor to blood ratio, hypoxic volume) and MRI parameters (Ktrans, CBV) with overall survival, time to disease progression, and 6-month progression free survival in participants with newly diagnosed glioblastoma multiforme (GBM). The trial also collected standard brain cancer data such as Karnofsky performance status, but also pathological biomarkers that included MGMT status, HIF1-alpha, GLUT1, CAIX, CD31, and alpha-SMA expression assays.",
          "descriptionType": "Abstract",
          "lang": null
        }
